<odoo>
    <record id="action_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">reservation.reservation</field>
        <field name="view_mode">list,form</field> <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first reservation!</p>
        </field>
    </record>

    <menuitem id="menu_reservation_root" 
              name="Reservation" 
              web_icon="base,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_reservation_category" 
              name="Management" 
              parent="menu_reservation_root" 
              sequence="10"/>

    <menuitem id="menu_reservation_list" 
              name="Reservations" 
              parent="menu_reservation_category" 
              action="action_reservation" 
              sequence="10"/>
</odoo>