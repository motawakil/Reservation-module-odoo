<odoo>
    
        <!-- ========================================= -->
    <!-- RESERVATION MAIN LIST VIEW               -->
    <!-- ========================================= -->
    
    
    <record id="view_reservation_list" model="ir.ui.view">
        <field name="name">reservation.reservation.list</field>
        <field name="model">reservation.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">
                <field name="name" decoration-bf="1"/>
                <field name="partner_id"/>
                <field name="reservation_date"/>
                <field name="amount_total" sum="Total Amount"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- RESERVATION FORM VIEW                    -->
    <!-- ========================================= -->

    <record id="view_reservation_form" model="ir.ui.view">
        <field name="name">reservation.reservation.form</field>
        <field name="model">reservation.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state not in ['draft', 'cancelled']"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_print_reservation" string="Imprimer PDF" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-usd" invisible="not sale_order_id">  </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="reservation_date"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>







</odoo>