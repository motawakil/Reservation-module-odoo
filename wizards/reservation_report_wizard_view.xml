<odoo>
    <record id="view_reservation_excel_wizard_form" model="ir.ui.view">
        <field name="name">reservation.excel.wizard.form</field>
        <field name="model">reservation.excel.wizard</field> <field name="arch" type="xml">
            <form string="Exporter les Réservations">
                <group>
                    <group>
                        <field name="date_start"/>
                    </group>
                    <group>
                        <field name="date_end"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_excel" string="Exporter Excel" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reservation_excel_wizard" model="ir.actions.act_window">
        <field name="name">Rapport Excel (Filtré)</field>
        <field name="res_model">reservation.excel.wizard</field> <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>