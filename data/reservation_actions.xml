<odoo>

    <!-- Main reservation action -->
    <record id="action_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">reservation.reservation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Report action — explicitly bind each view -->
    <record id="action_reservation_report_all" model="ir.actions.act_window">
        <field name="name">Tableau de Bord</field>
        <field name="res_model">reservation.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="views" eval="[
            (ref('view_reservation_report_pivot'), 'pivot'),
            (ref('view_reservation_report_graph'), 'graph'),
            (ref('view_reservation_report_list'),  'list'),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pas encore de données pour l'analyse.
            </p>
        </field>
    </record>

</odoo>