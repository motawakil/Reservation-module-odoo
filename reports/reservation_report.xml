<odoo>
    <record id="action_report_reservation" model="ir.actions.report">
        <field name="name">Fiche de Réservation</field>
        <field name="model">reservation.reservation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">reservation.report_reservation_document</field>
        <field name="report_file">reservation.report_reservation_document</field>
        <field name="print_report_name">'Reservation - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_reservation_reservation"/>
        <field name="binding_type">report</field>
    </record>

<record id="action_report_reservation_xlsx" model="ir.actions.report">
        <field name="name">Rapport Excel des Réservations</field>
        <field name="model">reservation.reservation</field>
        <field name="report_type">xlsx</field> <field name="report_name">reservation.reservation_report_xlsx</field>
        <field name="report_file">Rapport_Reservation</field>
        
        <field name="binding_model_id" ref="model_reservation_reservation"/>
        <field name="binding_type">report</field>
        
        <field name="binding_view_types">list</field>
    </record>



</odoo>